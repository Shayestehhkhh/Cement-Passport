            "value": {
              "type": "number",
              "minimum": 0,
              "description": "Early compressive strength in MPa."
            }
          }
        },
        "standardStrength28Days": {
          "type": "number",
          "minimum": 0,
          "description": "Standard (28-day) compressive strength in MPa."
        }
      }
