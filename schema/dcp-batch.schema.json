    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "solubleChromiumVI"
      ],
      "properties": {
        "solubleChromiumVI": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Water-soluble chromium VI in mg/kg of the total dry weight of cement; limit 2 mg/kg (0.0002 %) under REACH Annex XVII, entry 47."
        },
        "safetyDataSheet": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "energySourceType": {
      "enum": [
