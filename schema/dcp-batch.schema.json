{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/dcp/schema/dcp-batch.schema.json",
  "title": "Digital Cement Passport (DCP) - batch record",
  "description": "Illustrative JSON Schema of the Digital Cement Passport framework. Pilot artefact for demonstration only; not a conformity-assessment or regulatory-compliance tool.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "batchID",
    "passportURI",
    "traceability",
    "composition",
    "strength",
    "safety",
    "lcaIndicators"
  ],
  "properties": {
    "batchID": {
      "type": "string",
      "minLength": 1,
      "description": "Unique, immutable batch identifier; primary key across all layers."
    },
    "passportURI": {
      "type": "string",
      "format": "uri",
      "description": "Resolvable URI of the batch passport; content of the QR data carrier. In this pilot its last path segment must equal the batchID (checked by validate_passport.py)."
    },
    "traceability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manufacturerID",
        "plantLocation",
        "productSKU",
        "manufacturingDate"
      ],
      "properties": {
        "manufacturerID": {
          "type": "string",
          "minLength": 1
        },
        "plantLocation": {
          "type": "string",
          "minLength": 1
        },
        "productSKU": {
          "type": "string",
          "minLength": 1
        },
        "manufacturingDate": {
          "type": "string",
          "format": "date"
        },
        "quarryLocation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "latitude",
            "longitude"
          ],
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          }
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cementType",
        "strengthClass",
        "clinkerRatio",
        "constituents"
      ],
      "properties": {
        "cementType": {
          "$ref": "#/definitions/cementTypeEN197_1"
        },
        "strengthClass": {
          "$ref": "#/definitions/strengthClassEN197_1"
        },
        "clinkerRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "Clinker, % by mass of the sum of main and minor additional constituents (EN 197-1)."
        },
        "constituents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "role",
              "casNumber",
              "massPercent"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "clinker",
                  "mainConstituent",
                  "minorAdditionalConstituent",
                  "calciumSulfate",
                  "additive"
                ]
              },
              "en197Constituent": {
                "enum": [
                  "K",
                  "S",
                  "D",
                  "P",
                  "Q",
                  "V",
                  "W",
                  "T",
                  "L",
                  "LL"
                ],
                "description": "Constituent notation of EN 197-1: K clinker, S blast-furnace slag, D silica fume, P natural pozzolana, Q natural calcined pozzolana, V siliceous fly ash, W calcareous fly ash, T burnt shale, L and LL limestone."
              },
              "casNumber": {
                "type": "string",
                "pattern": "^\\d{2,7}-\\d{2}-\\d$"
              },
              "massPercent": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": [
                        "clinker",
                        "mainConstituent",
                        "minorAdditionalConstituent"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "en197Constituent"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "clinker"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "en197Constituent": {
                      "const": "K"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "const": "mainConstituent"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "en197Constituent": {
                      "not": {
                        "const": "K"
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "role": {
                      "enum": [
                        "calciumSulfate",
                        "additive"
                      ]
                    }
                  }
                },
                "then": {
                  "not": {
                    "required": [
                      "en197Constituent"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "allOf": [
