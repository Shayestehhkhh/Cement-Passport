  "definitions": {
    "cementTypeEN197_1": {
      "description": "The 27 products of the family of common cements, EN 197-1 Table 1.",
      "enum": [
        "CEM I",
        "CEM II/A-S",
        "CEM II/B-S",
        "CEM II/A-D",
        "CEM II/A-P",
        "CEM II/B-P",
