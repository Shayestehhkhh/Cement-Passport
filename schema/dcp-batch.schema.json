    "lcaIndicators": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declaredUnit",
        "indicatorsPerModule"
      ],
      "properties": {
        "declaredUnit": {
          "const": "1 t cement",
          "description": "Declared unit, fixed to 1 t of cement in this pilot so that values of different batches can be compared without unit conversion."
        },
        "indicatorsPerModule": {
          "type": "array",
          "minItems": 1,
          "items": {
